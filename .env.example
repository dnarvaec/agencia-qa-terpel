# ============================================================
# VARIABLES DE ENTORNO — AGENCIA QA
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# ============================================================

# Red corporativa con inspección SSL — deshabilita verificación de certificados en Node.js
# Cambiar a 1 en entornos de producción con certificados válidos
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Servidor Express (Agencia QA) ---
# Puerto donde corre el servidor local. Por defecto 3000.
AGENT_UI_PORT=3000

# Origen(es) permitidos para conectarse al servidor via WebSocket (CORS).
# Por defecto solo se permite localhost. Para acceso remoto o desde otra máquina,
# especifica la URL exacta: AGENT_UI_ORIGIN=http://192.168.1.50:3000
# Acepta regex: AGENT_UI_ORIGIN=^https?:\/\/mi-dominio\.com$
AGENT_UI_ORIGIN=

# --- Opciones avanzadas de los servidores MCP ---
# Tiempo de espera (ms) antes de enviar el handshake inicial al servidor MCP.
# Aumentar si Playwright MCP falla en el primer arranque
MCP_START_DELAY_MS=3000

# Activa volcado de respuestas raw de Azure DevOps MCP en la consola del servidor.
# Útil para depurar respuestas inesperadas. NO activar en producción.
# Valores: true | false (por defecto false)
DEBUG_MCP=false

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://<nombre-recurso>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- API TerpelPosSAP ---
# URL base de la API REST SAP (sin /api/sap al final)
# QAS: https://qas.terpel.sclbox.com:18001
# PRD: https://nodos-terpelpos-gtic-apimanager-prd-apicast.devitech.group:18001
API_URL=https://qas.terpel.sclbox.com:18001

# URL base del SSO para generación de tokens
# QAS: https://qas.terpel.sclbox.com:7006
# PRD: https://nodos-terpelpos-gtic-apimanager-prd-apicast.devitech.group:7006
SSO_URL=https://qas.terpel.sclbox.com:7006

# Public key suministrada por TerpelPos (necesaria para generar tokens via SSO)
API_PUBLIC_KEY=your-public-key-here

# Bearer token estático (alternativa al SSO; útil en CI/CD cuando ya tienes el token)
API_TOKEN=
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/<nombre-organizacion>/
AZURE_DEVOPS_PROJECT=<nombre-proyecto>
AZURE_DEVOPS_PAT=your-personal-access-token

# --- URLs de la Aplicación ---
APP_URL=https://url-de-la-aplicacion-web
API_URL=https://url-de-la-api

# --- Automatización Web (Playwright) ---
# Usuario y contraseña por defecto para los tests de automatización web.
# Leídos desde automatizacion web/src/utils/env.ts vía env.defaultUser / env.defaultPassword.
DEFAULT_USER=usuario-de-prueba
DEFAULT_PASSWORD=contraseña-de-prueba

# --- Autenticación API (opcional — si la API requiere Bearer token) ---
API_TOKEN=your-api-token

# --- Microsoft Fabric + Power BI (Service Principal) ---
# Autenticación unificada para Fabric MCP y Power BI Modeling MCP.
# Cómo obtener estos valores:
#   1. Azure Portal → Azure Active Directory → App registrations → New registration
#   2. Copiar el Application (client) ID → AZURE_CLIENT_ID
#   3. Copiar el Directory (tenant) ID  → AZURE_TENANT_ID
#   4. Certificates & secrets → New client secret → copiar Value → AZURE_CLIENT_SECRET
#   5. Dar permisos al SP en el workspace de Fabric y Power BI (rol Contributor o Viewer)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ID del workspace principal en Fabric
# (visible en la URL: app.fabric.microsoft.com/groups/{id})
FABRIC_WORKSPACE_ID=your-fabric-workspace-id

# ID del workspace en Power BI
# (visible en la URL: app.powerbi.com/groups/{id})
POWERBI_WORKSPACE_ID=your-powerbi-workspace-id
