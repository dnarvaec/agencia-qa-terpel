{
  "name": "agencia-qa-comfama",
  "version": "1.0.0",
  "description": "Agencia de agentes QA con IA — NTT DATA x Comfama",
  "scripts": {
    "test:web": "playwright test --config \"automatizacion web/playwright.config.ts\"",
    "test:web:headed": "playwright test --config \"automatizacion web/playwright.config.ts\" --headed",
    "test:web:ui": "playwright test --config \"automatizacion web/playwright.config.ts\" --ui",
    "test:web:debug": "playwright test --config \"automatizacion web/playwright.config.ts\" --debug",
    "test:web:report": "playwright show-report \"automatizacion web/reports\"",
    "test:web:login": "playwright test --config \"automatizacion web/playwright.config.ts\" tests/login/",
    "test:web:inventory": "playwright test --config \"automatizacion web/playwright.config.ts\" tests/inventory/",
    "test:web:cart": "playwright test --config \"automatizacion web/playwright.config.ts\" tests/cart/",
    "test:web:checkout": "playwright test --config \"automatizacion web/playwright.config.ts\" tests/checkout/",
    "codegen": "playwright codegen",
    "test:api": "playwright test --config \"automatizacion api/playwright.config.ts\"",
    "test:api:ui": "playwright test --config \"automatizacion api/playwright.config.ts\" --ui",
    "test:api:debug": "playwright test --config \"automatizacion api/playwright.config.ts\" --debug",
    "test:api:report": "playwright show-report \"automatizacion api/reports\""
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "glob": "^11.0.0",
    "openai": "^4.98.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "typescript": "^5.4.5"
  }
}
